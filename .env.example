# Model storage directory (default: ./models)
AI_MODELS_DIR=./models

# Hugging Face token (optional, avoids rate limits)
HF_TOKEN=

# Host port for the Streamlit web interface (default: 8501)
HOST_PORT=8501

# llama.cpp - pre-built wheel index
# Picks a ready-to-use wheel from the llama-cpp-python project. No compilation needed.
# CPU:   https://abetlen.github.io/llama-cpp-python/whl/cpu
# Vulkan: https://abetlen.github.io/llama-cpp-python/whl/vulkan
# CUDA:  https://abetlen.github.io/llama-cpp-python/whl/cu124
# Metal: https://abetlen.github.io/llama-cpp-python/whl/metal
# ROCm:  https://abetlen.github.io/llama-cpp-python/whl/rocm72
# Default (CPU pre-built):
LLAMA_PIP_EXTRA_INDEX=https://abetlen.github.io/llama-cpp-python/whl/cpu

# For GPU acceleration, add this to docker-compose.yml under app:
#   devices:
#     - /dev/dri:/dev/dri
# Or for NVIDIA: deploy.resources.reservations.devices[0].capabilities=[gpu]

# llama.cpp - cmake build args for source compilation
# Only used when LLAMA_PIP_EXTRA_INDEX is empty AND LLAMA_CMAKE_ARGS is set.
# When both are set, CMAKE_ARGS takes priority (compiles from source).
# Example for Vulkan: LLAMA_CMAKE_ARGS=-DGGML_VULKAN=on
# Example for CUDA:   LLAMA_CMAKE_ARGS=-DGGML_CUDA=on
# LLAMA_CMAKE_ARGS=

# llama.cpp server defaults
LLAMA_SERVER_PORT=8001
LLAMA_N_CTX=2048
LLAMA_N_GPU_LAYERS=-1
LLAMA_N_THREADS=4
LLAMA_SEED=-1
